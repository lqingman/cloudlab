# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored (see ../.gitignore).
#
# Get a DO API token: https://cloud.digitalocean.com/account/api/tokens
# Prefer exporting it instead of writing it here:  export TF_VAR_do_token=dop_v1_xxx

do_token = "dop_v1_REPLACE_ME"

# Your SSH public key contents (cat ~/.ssh/id_ed25519.pub  — or id_rsa.pub).
ssh_public_key = "ssh-ed25519 AAAA... you@host"

droplet_name = "vpn-sgp"
region       = "sgp1"
droplet_size = "s-2vcpu-4gb-intel"

# Tighten this to your home/office IP for better security, e.g. ["203.0.113.4/32"].
# Leaving it open is fine to start, but tfsec/checkov will (correctly) flag it.
# allowed_ssh_cidrs = ["0.0.0.0/0", "::/0"]
