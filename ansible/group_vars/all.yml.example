---
# Copy to all.yml. Keep SECRETS encrypted with ansible-vault:
#   ansible-vault encrypt group_vars/all.yml
# (all.yml is git-ignored; only this .example is committed.)
#
# This file holds ONLY what every node shares. Anything that differs per node —
# the Reality dest/SNI and the node's Xray identity — lives in host_vars/<host>.yml
# so that running the playbook against one node cannot rewrite another's config.
# See host_vars/*.yml.example.

# --- non-secret ---
deploy_user: deploy
ssh_port: 22
xray_port: 443
swap_file: /swapfile
swap_size: 2G
swap_swappiness: 10

# --- secrets: generate, then vault-encrypt this file ---
# SSH public key to install for the deploy user (same key across nodes is fine):
ssh_public_key: "ssh-ed25519 AAAA... you@host"
