---
# Copy to gcp-vpn.yml (matching the inventory host name), then vault-encrypt it:
#   ansible-vault encrypt host_vars/gcp-vpn.yml
# The real file is git-ignored; only this .example is committed.
#
# See host_vars/oci-vpn.yml.example for what belongs here versus in
# group_vars/all.yml. Generate a fresh UUID, keypair, and short id for this
# node rather than reusing another node's.

# --- Reality camouflage target ---
# Verified from the Tokyo node: TLS 1.3 + h2. Apple carries heavy traffic in
# Japan, so a connection from China to an Apple endpoint in the region is
# unremarkable. Kept different from the OCI node's dest on purpose.
reality_dest: "www.icloud.com:443"
reality_sni: "www.icloud.com"

# --- Per-node secrets ---
xray_uuid: "REPLACE-WITH-UUID"
xray_private_key: "REPLACE-WITH-REALITY-PRIVATE-KEY"
xray_public_key: "REPLACE-WITH-REALITY-PUBLIC-KEY"
xray_short_id: "REPLACE-WITH-SHORTID"
