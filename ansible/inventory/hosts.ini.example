# Copy to hosts.ini and set the IP (use the reserved IP from `terraform output`).
# OCI Ubuntu images use the ubuntu user for the first run. After the
# hardening role runs you can switch ansible_user to the deploy user.

[vpn]
oci-vpn ansible_host=REPLACE_WITH_RESERVED_IP ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_ed25519
